<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xmlns:context="http://www.springframework.org/schema/context"
       xsi:schemaLocation="
        http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd
        http://www.springframework.org/schema/context
        http://www.springframework.org/schema/context/spring-context.xsd">

    <context:property-placeholder location="classpath:application.properties"/>

    <bean id="currentDateTime" class="java.time.LocalDateTime" factory-method="now"/>

    <bean id="cities" class="java.util.ArrayList">
        <constructor-arg>
            <list>
                <value>#{'${weather.cities}'.split(',')}</value>
            </list>
        </constructor-arg>
    </bean>

    <bean id="weatherProvider" class="sia.MockWeatherProvider"/>

    <bean id="weatherCache" class="sia.SimpleWeatherCache"/>

    <bean id="weatherService" class="sia.WeatherService">
        <constructor-arg ref="weatherProvider"/>
        <constructor-arg ref="weatherCache"/>
        <constructor-arg value="${cache.enabled}"/>
    </bean>

    <bean id="weatherController" class="sia.WeatherController">
        <constructor-arg ref="weatherService"/>
        <constructor-arg ref="cities"/>
    </bean>

</beans>